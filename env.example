# Resend API key — get one free at resend.com
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Your email — get notified on every new subscriber (includes their address)
RESEND_NOTIFY_TO="you@example.com"

# Optional. If unset, the API finds or creates a Resend segment named "Lab Notes".
# Prefer Segments (Audiences are deprecated). RESEND_AUDIENCE_ID still works as a fallback ID.
# RESEND_SEGMENT_ID=""
# RESEND_AUDIENCE_ID=""

# Verified sender on your domain (e.g. hello@kardashevlabs.org).
# Defaults to onboarding@resend.dev if unset.
# RESEND_FROM_EMAIL="hello@kardashevlabs.org"

# Site URL for SEO metadata
NEXT_PUBLIC_SITE_URL="https://kardashevlabs.org"
